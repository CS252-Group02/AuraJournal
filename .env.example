DATABASE_URL=postgresql+psycopg://aurajournal:aurajournal@localhost:5432/aurajournal
FRONTEND_ORIGIN=http://localhost:5173
AUTH_COOKIE_SECURE=false
# Set both provider keys for the normal staging smoke test. Leave GROQ_API_KEY
# empty on isolated staging for the reflection-unavailable scenario.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
DEEPGRAM_API_KEY=
PIXELLAB_ENABLED=false
PIXELLAB_API_KEY=
# Automatic jobs run on journal create/content edit when PIXELLAB_ENABLED=true.
# See docs/pixel-art.md for external-service disclosure and deployment requirements.
PIXEL_ART_WORKER_ENABLED=true
PIXEL_ART_CONCURRENCY=2
PIXEL_ART_USER_DAILY_LIMIT=20
PIXEL_ART_DAILY_LIMIT=200
# Optional absolute path to a private persistent volume (default: var/journal-images).
JOURNAL_IMAGE_STORAGE_DIR=


# See docs/security-hardening.md before deployment.
APP_ENV=development
# Separate owner credentials for Alembic; never use these for the API.
MIGRATION_DATABASE_URL=
